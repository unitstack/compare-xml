{
  "name": "@compare-xml/cli",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Command-line tool and MCP server for structured XML comparison.",
  "keywords": [
    "compare xml",
    "xml comparison",
    "xml diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unitstack/compare-xml.git",
    "directory": "packages/compare-xml-cli"
  },
  "bin": {
    "compare-xml": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "lint": "eslint",
    "test": "npm run test-type && npm run test-coverage && npm run test-e2e",
    "test-type": "tsc --noEmit",
    "test-unit": "vitest run src",
    "test-coverage": "vitest run src --coverage",
    "test-e2e": "vitest run e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@compare-xml/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "commander": "^14.0.3",
    "package-directory": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@compare-xml/eslint-config": "workspace:*",
    "@compare-xml/tsconfig": "workspace:*",
    "@types/commander": "^2.12.5",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "@rslib/core": "^0.21.5",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}

{
  "name": "@compare-xml/core",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Lightweight library for structured XML comparison.",
  "keywords": [
    "compare xml",
    "xml comparison",
    "xml diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unitstack/compare-xml.git",
    "directory": "packages/compare-xml-core"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "lint": "eslint",
    "test": "npm run test-type && npm run test-coverage",
    "test-type": "tsc --noEmit",
    "test-unit": "vitest run",
    "test-coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@compare-json/core": "^0.1.2",
    "fast-xml-parser": "^5.8.0"
  },
  "devDependencies": {
    "@compare-xml/eslint-config": "workspace:*",
    "@compare-xml/tsconfig": "workspace:*",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "@rslib/core": "^0.21.5",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
